server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    # The browser talks to the gateway (${API_BASE_URL}) directly and uploads evidence straight to GCS;
    # nothing else may be contacted.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ${API_BASE_URL} https://storage.googleapis.com; frame-ancestors 'none'" always;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Runtime config, rendered from the container environment so one image serves any deployment.
    location = /config.js {
        default_type application/javascript;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        return 200 "window.__TRIAGE_CONFIG__ = { apiBase: \"${API_BASE_URL}\" };\n";
    }

    location /_next/static/ {
        # `expires` (not add_header) so the server-level security headers are still inherited here.
        expires 1y;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri.html $uri/ /index.html;
    }
}
